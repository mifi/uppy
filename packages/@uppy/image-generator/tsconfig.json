{
  "extends": "../../../tsconfig.shared",
  "compilerOptions": {
    // TODO: enable noUncheckedIndexedAccess (https://github.com/transloadit/uppy/issues/5336)
    "noUncheckedIndexedAccess": false,
    // TODO: enable exactOptionalPropertyTypes (https://github.com/transloadit/uppy/issues/5336)
    "exactOptionalPropertyTypes": false,
    "emitDeclarationOnly": false,
    "noEmit": true
  },
  "include": ["./package.json", "./src/**/*.*"],
  "references": [
    {
      "path": "../core/tsconfig.build.json"
    },
    {
      "path": "../transloadit/tsconfig.build.json"
    }
  ]
}
