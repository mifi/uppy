{
  "extends": "@tsconfig/strictest/tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "declaration": true,
    "target": "es2022",
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": false,
    "allowJs": false,
    "checkJs": false,
    "resolveJsonModule": true
  }
}
